# ── Copy this to .env.local for local development ──
# In Vercel dashboard: Project Settings → Environment Variables

# REQUIRED — Google Gemini API key (FREE, no credit card)
# Get it at: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=AIzaSy-your-key-here

# OPTIONAL — Lock CORS to your domain (recommended for production)
ALLOWED_ORIGIN=https://your-app.vercel.app

# OPTIONAL — Secret to protect manual cron trigger
CRON_SECRET=your-random-secret-here

# OPTIONAL — Vercel KV for persistent monthly song cache
KV_REST_API_URL=
KV_REST_API_TOKEN=
